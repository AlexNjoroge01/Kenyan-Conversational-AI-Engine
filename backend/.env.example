NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Set true when running behind a reverse proxy / load balancer (needed for correct client IPs)
TRUST_PROXY=false

DATABASE_URL=postgres://postgres:postgres@localhost:5432/kenya_engine

# Generate: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=7d
AUTH_COOKIE_NAME=auth_token
AUTH_COOKIE_SAMESITE=lax
BCRYPT_COST=12

CORS_ORIGINS=http://localhost:3000

API_KEY_PREFIX=sk_live_

MAX_JSON_BODY_BYTES=1000000
MAX_UPLOAD_BYTES=26214400
TTS_MAX_INPUT_CHARACTERS=4000

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# Provider mode per model: "http" talks to the GPU worker, "mock" uses an in-process fake (no GPU needed).
STT_PROVIDER=mock
STT_SERVICE_URL=http://localhost:8001
STT_SERVICE_TIMEOUT_MS=60000

SLM_PROVIDER=mock
SLM_SERVICE_URL=http://localhost:8002
SLM_SERVICE_TIMEOUT_MS=60000

TTS_PROVIDER=mock
TTS_SERVICE_URL=http://localhost:8000
TTS_SERVICE_TIMEOUT_MS=30000

# Dependencies /ready must confirm (database,stt,slm,tts)
READINESS_REQUIRED=database,stt,slm,tts

# Used by the GPU workers / docker-compose to download models from Hugging Face
HF_TOKEN=
