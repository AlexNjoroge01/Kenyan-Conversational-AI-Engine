NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Set true when running behind a reverse proxy / load balancer (Render, Fly...): needed for correct client IPs
TRUST_PROXY=false

# Neon: paste the connection string as given (sslmode=verify-full is supported without warnings)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/kenya_engine

# Generate: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=7d
AUTH_COOKIE_NAME=auth_token
# lax (default; same-site / Next.js rewrite proxy) | strict | none (cross-site cookies; forces Secure)
COOKIE_SAMESITE=lax
BCRYPT_COST=12

CORS_ORIGINS=http://localhost:3000

API_KEY_PREFIX=sk_live_

MAX_JSON_BODY_BYTES=1000000
MAX_UPLOAD_BYTES=26214400
TTS_MAX_INPUT_CHARACTERS=4000

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# --- Speech-to-text -------------------------------------------------------------
# groq (hosted Whisper) | http (self-hosted worker) | mock (no network)
STT_PROVIDER=mock
STT_TIMEOUT_MS=60000
# Groq (used when STT_PROVIDER=groq). Uploads are capped at the lower of MAX_UPLOAD_BYTES and GROQ_STT_MAX_FILE_BYTES.
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_STT_MAX_FILE_BYTES=25000000
# Self-hosted worker (used when STT_PROVIDER=http)
STT_SERVICE_URL=http://localhost:8001

# --- Language model -------------------------------------------------------------
# http (Kaggle/GPU worker) | openai-compatible (hosted fallback) | mock
SLM_PROVIDER=mock
SLM_SERVICE_URL=http://localhost:8002
SLM_SERVICE_TIMEOUT_MS=120000
# Hosted fallback (used when SLM_PROVIDER=openai-compatible), e.g. OpenRouter:
#   SLM_BASE_URL=https://openrouter.ai/api/v1   SLM_MODEL=qwen/qwen3.5-9b
# or Hugging Face Inference Providers:
#   SLM_BASE_URL=https://router.huggingface.co/v1   SLM_MODEL=Qwen/Qwen3.5-9B:deepinfra
SLM_BASE_URL=
SLM_API_KEY=
SLM_MODEL=
# auto | reasoning (OpenRouter) | chat_template_kwargs (vLLM/SGLang/HF) | none
SLM_DISABLE_THINKING=auto

# --- Text-to-speech -------------------------------------------------------------
# http (Kaggle/GPU worker) | mock
TTS_PROVIDER=mock
TTS_SERVICE_URL=http://localhost:8000
TTS_SERVICE_TIMEOUT_MS=120000

# Shared secret sent to the GPU worker as X-Worker-Key (required in production when a worker is used).
# Generate: openssl rand -hex 32
WORKER_API_KEY=

# Dependencies /ready must confirm (database,stt,slm,tts)
READINESS_REQUIRED=database,stt,slm,tts

# Used by the local GPU workers / docker-compose to download models from Hugging Face (not by the API)
HF_TOKEN=
